# GitHub token for gh CLI (or use `gh auth login`)
# GITHUB_TOKEN=ghp_...

# Fly.io access token
# FLY_ACCESS_TOKEN=...

# Kill switch: set to "false" to disable all GitHub/Fly write actions
LATTICE_WRITE_ACTIONS=true

# Flyctl: disabled by default, set to "true" to enable
LATTICE_ENABLE_FLYCTL=false
